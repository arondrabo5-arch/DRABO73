
const express = require("express");
const cors = require("cors");

const app = express();

app.use(cors());
app.use(express.json());

// Configuration
const PORT = process.env.PORT || 3000;
const API_KEY = process.env.FOOTBALL_DATA_API_KEY;
const FOOTBALL_API = "https://api.football-data.org/v4";

// Accueil
app.get("/", (req, res) => {
  res.json({
    application: "DRABO73 VIP PRONOS",
    slogan: "La confiance reste",
    status: "Serveur actif"
  });
});

// Statut du serveur
app.get("/api/status", (req, res) => {
  res.json({
    status: "OK",
    application: "DRABO73",
    apiConfigured: Boolean(API_KEY)
  });
});

// Matchs réels football-data.org
app.get("/api/matches", async (req, res) => {
  if (!API_KEY) {
    return res.status(503).json({
      status: "ERROR",
      message: "FOOTBALL_DATA_API_KEY non configurée sur Render"
    });
  }

  try {
    const response = await fetch(
      `${FOOTBALL_API}/matches`,
      {
        method: "GET",
        headers: {
          "X-Auth-Token": API_KEY
        }
      }
    );

    const data = await response.json();

    if (!response.ok) {
      return res.status(response.status).json({
        status: "ERROR",
        message: data.message || "Erreur football-data.org"
      });
    }

    res.json({
      status: "OK",
      application: "DRABO73 VIP PRONOS",
      total: data.resultSet?.count || data.matches?.length || 0,
      matches: data.matches || []
    });

  } catch (error) {
    res.status(500).json({
      status: "ERROR",
      message: "Impossible de contacter football-data.org"
    });
  }
});

// Route analyses
app.get("/api/predictions", (req, res) => {
  res.json({
    status: "OK",
    message: "Service de pronostics disponible",
    predictions: []
  });
});

// Route VIP
app.get("/api/vip", (req, res) => {
  res.json({
    status: "OK",
    application: "DRABO73 VIP PRONOS",
    plans: [
      { duration: "7 jours", price: 5000 },
      { duration: "30 jours", price: 15000 },
      { duration: "90 jours", price: 35000 }
    ]
  });
});

// Route inconnue
app.use((req, res) => {
  res.status(404).json({
    status: "ERROR",
    message: "Route introuvable",
    route: req.path
  });
});

// Démarrage
app.listen(PORT, () => {
  console.log(`DRABO73 VIP PRONOS actif sur le port ${PORT}`);
});
