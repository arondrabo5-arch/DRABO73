
const express = require("express");
const cors = require("cors");

const app = express();

app.use(cors());
app.use(express.json());

// Accueil
app.get("/", (req, res) => {
  res.json({
    application: "DRABO73 VIP PRONOS",
    status: "Serveur actif"
  });
});

// Vérification du serveur
app.get("/api/status", (req, res) => {
  res.json({
    status: "OK",
    application: "DRABO73"
  });
});

// Récupération des vrais matchs
app.get("/api/matches", async (req, res) => {
  const token = process.env.FOOTBALL_DATA_API_KEY;

  if (!token) {
    return res.status(503).json({
      error: "Clé FOOTBALL_DATA_API_KEY absente dans Render"
    });
  }

  try {
    const response = await fetch(
      "https://api.football-data.org/v4/matches",
      {
        headers: {
          "X-Auth-Token": token
        }
      }
    );

    const data = await response.json();

    if (!response.ok) {
      return res.status(response.status).json(data);
    }

    return res.json(data);

  } catch (error) {
    return res.status(500).json({
      error: "Erreur de connexion à football-data.org"
    });
  }
});

// Démarrage du serveur (une seule fois)
const PORT = process.env.PORT || 3000;

app.listen(PORT, () => {
  console.log(`DRABO73 serveur actif sur le port ${PORT}`);
});
